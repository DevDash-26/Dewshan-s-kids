# Copy this file to .env for local development.
# The frontend talks to the local Node backend through Vite's /api proxy.
VITE_API_URL=/api

# Base URL of the Strapi CMS (see /cms). Defaults to http://localhost:1337.
VITE_STRAPI_URL=http://localhost:1337

# Optional: Google AI Studio Gemini API key. If left blank, the AI Assistant
# falls back to a deterministic keyword search over the same campus content
# instead of failing (see src/lib/ai.ts).
VITE_GEMINI_API_KEY=
