# Copy this file to .env and fill in your own values.
# Firebase web config is a public client identifier, not a secret — see
# https://firebase.google.com/docs/projects/api-keys. Access control is
# enforced by firestore.rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run against the local Firebase Emulator Suite
# (firebase emulators:start) instead of a live project.
VITE_USE_FIREBASE_EMULATORS=false

# Base URL of the Strapi CMS (see /cms). Defaults to http://localhost:1337.
VITE_STRAPI_URL=http://localhost:1337

# Optional: Google AI Studio Gemini API key. If left blank, the AI Assistant
# falls back to a deterministic keyword search over the same campus content
# instead of failing (see src/lib/ai.ts).
VITE_GEMINI_API_KEY=
